# =============================================================================
# IgrejaHub Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com valores reais no repositório.
# =============================================================================

# --- Banco de Dados PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=igrejahub
DB_USER=igrejahub
DB_PASSWORD=igrejahub123

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
# Gere um secret seguro: openssl rand -base64 64
# Mínimo recomendado: 64 caracteres
JWT_SECRET=SUBSTITUA_POR_UM_SECRET_SEGURO_GERADO_COM_openssl_rand_base64_64
JWT_ACCESS_EXPIRATION=900      # segundos (15 minutos)
JWT_REFRESH_EXPIRATION=604800  # segundos (7 dias)

# --- Aplicação ---
SERVER_PORT=8080
LOG_LEVEL=INFO

# --- Usuário Admin Root ---
# Senha inicial do admin. Troque imediatamente após o primeiro login.
ROOT_EMAIL=admin@igrejahub.com
ROOT_PASSWORD=Root@2024#Secure

# --- CORS ---
# Lista de origens permitidas, separadas por vírgula.
# Em produção: substitua pelo domínio real do frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000
FRONTEND_URL=http://localhost:5000

# --- Email (opcional — usado para reset de senha) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Storage (opcional — para upload de arquivos) ---
STORAGE_TYPE=local
STORAGE_LOCAL_UPLOAD_DIR=./uploads
